# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: dedicated short-link host (must route /r/:code to this app). Defaults to NEXT_PUBLIC_APP_URL.
SHORT_URL_BASE=
# Random 32+ chars. Used to hash visitor IPs (rotated daily) so raw IPs are never stored.
CLICK_HASH_SECRET=change-me-to-a-long-random-string

# --- Supabase (Auth + Postgres) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Pooled connection (pgbouncer) for the app, direct connection for migrations
DATABASE_URL="postgresql://postgres.YOUR-REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@db.YOUR-REF.supabase.co:5432/postgres"

# --- Admin Authentication & Security ---
ADMIN_EMAILS="admin@earnkaro.com,admin@earnkaro.local"
ADMIN_SECRET="earnkaro-admin-secret-2026"

# --- YOUR affiliate credentials (you must be approved by each programme/network) ---
# Flipkart Affiliate: your affiliate ID (appended as ?affid=...&affExtParam1=<subid>)
FLIPKART_AFFID=
# Myntra / Ajio are usually reached through an affiliate network. Paste that network's
# deeplink URL pattern. {url} = URL-encoded product URL, {subid} = our tracking sub-id.
# e.g. https://YOUR-NETWORK/click?pub=12345&url={url}&subid={subid}
MYNTRA_DEEPLINK_TEMPLATE=
AJIO_DEEPLINK_TEMPLATE=

# --- Conversion postbacks: one HMAC secret per store slug (flipkart, myntra, ajio) ---
POSTBACK_SECRET_FLIPKART=
POSTBACK_SECRET_MYNTRA=
POSTBACK_SECRET_AJIO=

# --- Cuelinks Integration ---
CUELINKS_API_KEY=
CUELINKS_CHANNEL_ID=
USER_COMMISSION_PERCENT=70
