# ---- Telegram Bot (from @BotFather) ----
BOT_TOKEN=your_bot_token_here

# ---- Telegram user-account API (https://my.telegram.org -> API development tools) ----
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=your_api_hash_here

# ---- Telethon StringSession: run `python generate_session.py` once, paste output here ----
TELETHON_SESSION_STRING=

# ---- Your web platform ----
BASE_WEB_URL=https://kamai-three.vercel.app

# Optional: shared secret sent as "x-worker-secret" header to your API (if you enforce one)
WORKER_API_SECRET=

# Optional tuning
CONFIG_SYNC_INTERVAL=60
HTTP_TIMEOUT=20
LOG_LEVEL=INFO
